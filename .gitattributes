# Auto-detect text files and normalize line endings to LF in the repository
* text=auto eol=lf

# C++ source and headers
*.h     text eol=lf
*.hpp   text eol=lf
*.cpp   text eol=lf
*.c     text eol=lf

# Build and CI configuration
CMakeLists.txt text eol=lf
*.cmake        text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.py           text eol=lf
*.md           text eol=lf
*.txt          text eol=lf

# Visual Studio project files require CRLF
*.sln             text eol=crlf merge=binary
*.vcxproj         text eol=crlf merge=binary
*.vcxproj.filters text eol=crlf merge=binary
*.bat             text eol=crlf
*.cmd             text eol=crlf

# Binary assets
*.png  binary
*.jpg  binary
*.gif  binary
*.xcf  binary
*.ttf  binary
*.ttc  binary
*.otf  binary
*.wav  binary
*.ogg  binary
*.dll  binary
*.lib  binary
*.exe  binary
